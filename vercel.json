{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "asgi.py": {
      "excludeFiles": "{backend/tests/**,backend/alembic/**,backend/seed_data/**,docs/**,**/__pycache__/**,*.md,nginx.conf,docker-compose.yml,Makefile}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/cleanup",
      "schedule": "0 21 * * *"
    }
  ]
}

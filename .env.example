# Скопируйте в .env и поправьте под себя
POSTGRES_USER=tilashar
POSTGRES_PASSWORD=tilashar
POSTGRES_DB=tilashar

DATABASE_URL=postgresql+psycopg://tilashar:tilashar@db:5432/tilashar
# Не короче 32 байт
JWT_SECRET=change-me-to-a-long-random-string-32b+
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=400

# Пароль автора для редактора слов (страница /#author). Пусто — редактор выключен.
ADMIN_PASSWORD=
# Секрет ежедневной уборки (Vercel Cron присылает его сам, если переменная задана)
CRON_SECRET=

MAX_CHILDREN=4
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

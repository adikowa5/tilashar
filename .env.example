# Скопируйте в .env и поправьте под себя
POSTGRES_USER=tilashar
POSTGRES_PASSWORD=tilashar
POSTGRES_DB=tilashar

DATABASE_URL=postgresql+psycopg://tilashar:tilashar@db:5432/tilashar
# Не короче 32 байт
JWT_SECRET=change-me-to-a-long-random-string-32b+
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=30

# console — код всегда 000000 и пишется в лог; mobizon — боевая отправка
SMS_PROVIDER=console
MOBIZON_API_KEY=

MEDIA_ROOT=/data/media
MAX_CHILDREN=4
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
